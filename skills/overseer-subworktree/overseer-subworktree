#!/bin/bash
# Creates a Worktrunk worktree for a sub-task and records the worktree this runs
# in as its parent (Worktrunk's per-branch `overseer-parent` variable), so
# Overseer's Projects panel nests the new worktree under it.
#
# The parent is wherever this runs, never an argument: an agent can't attach
# work to a worktree it isn't in.
#
# Usage: overseer-subworktree BRANCH [--base REF]
set -euo pipefail

usage() {
    printf 'Usage: %s BRANCH [--base REF]\n' "${0##*/}" >&2
    exit 64
}

[ "$#" -ge 1 ] || usage
branch=$1
shift
base=''
while [ "$#" -gt 0 ]; do
    case "$1" in
        --base) [ "$#" -ge 2 ] || usage; base=$2; shift 2 ;;
        --base=*) base=${1#--base=}; shift ;;
        *) usage ;;
    esac
done
case "$branch" in
    ''|-*) printf 'Branch must be a name, not an option: %s\n' "$branch" >&2; exit 64 ;;
esac

wt=$(command -v wt) || { printf 'Worktrunk (wt) is not on PATH.\n' >&2; exit 69; }
parent=$(git rev-parse --show-toplevel 2>/dev/null) || {
    printf 'Run this inside the worktree that owns the sub-task.\n' >&2
    exit 65
}
parent_branch=$(git -C "$parent" symbolic-ref --quiet --short HEAD) || {
    printf 'The worktree at %s has a detached HEAD; check out its branch first.\n' "$parent" >&2
    exit 65
}

args=(switch --create --no-cd)
if [ -n "$base" ]; then args+=(--base "$base"); fi
# Hooks and approvals run as usual: no --yes, no --no-hooks.
"$wt" -C "$parent" "${args[@]}" "$branch"

"$wt" -C "$parent" config state vars set --branch="$branch" "overseer-parent=$parent_branch" >/dev/null || {
    printf 'Created %s but could not record its parent. Run:\n  wt config state vars set --branch=%q overseer-parent=%q\n' \
        "$branch" "$branch" "$parent_branch" >&2
    exit 1
}

path=$(git -C "$parent" worktree list --porcelain | awk -v ref="refs/heads/$branch" '
    $1 == "worktree" { path = substr($0, 10) }
    $1 == "branch" && $2 == ref { print path }
')
printf 'Created %s under %s\n%s\n' "$branch" "$parent_branch" "$path"
