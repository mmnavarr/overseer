#!/bin/bash
# Creates a Worktrunk worktree for a sub-task and records the worktree this runs
# in as its parent (Worktrunk's per-branch `overseer-parent` variable), so
# Overseer's Projects panel nests the new worktree under it.
#
# The parent is wherever this runs, never an argument: an agent can't attach
# work to a worktree it isn't in. The primary checkout owns nothing: work
# started there gets a top-level worktree (`wt switch --create`), so the
# hierarchy groups tasks instead of piling everything under the default branch.
#
# --brief FILE (or --brief - for stdin) hands the new worktree its first task:
# the text is saved as overseer-brief.md in the worktree's private git dir, and
# Overseer starts an omp session there with it as the first prompt.
#
# Usage: overseer-subworktree BRANCH [--base REF] [--brief FILE|-]
set -euo pipefail

usage() {
    printf 'Usage: %s BRANCH [--base REF] [--brief FILE|-]\n' "${0##*/}" >&2
    exit 64
}

[ "$#" -ge 1 ] || usage
branch=$1
shift
base=''
brief_source=''
while [ "$#" -gt 0 ]; do
    case "$1" in
        --base) [ "$#" -ge 2 ] || usage; base=$2; shift 2 ;;
        --base=*) base=${1#--base=}; shift ;;
        --brief) [ "$#" -ge 2 ] || usage; brief_source=$2; shift 2 ;;
        --brief=*) brief_source=${1#--brief=}; shift ;;
        *) usage ;;
    esac
done
case "$branch" in
    ''|-*) printf 'Branch must be a name, not an option: %s\n' "$branch" >&2; exit 64 ;;
esac

# Read the brief before creating anything, so a bad brief leaves no worktree behind.
brief=''
if [ -n "$brief_source" ]; then
    if [ "$brief_source" = - ]; then
        brief=$(cat)
    elif [ -f "$brief_source" ]; then
        brief=$(cat -- "$brief_source")
    else
        printf 'Brief file not found: %s\n' "$brief_source" >&2
        exit 66
    fi
    case "$brief" in
        *[![:space:]]*) ;;
        *) printf 'The brief is empty.\n' >&2; exit 65 ;;
    esac
fi

wt=$(command -v wt) || { printf 'Worktrunk (wt) is not on PATH.\n' >&2; exit 69; }
parent=$(git rev-parse --show-toplevel 2>/dev/null) || {
    printf 'Run this inside the worktree that owns the sub-task.\n' >&2
    exit 65
}
parent_branch=$(git -C "$parent" symbolic-ref --quiet --short HEAD) || {
    printf 'The worktree at %s has a detached HEAD; check out its branch first.\n' "$parent" >&2
    exit 65
}
own_dir=$(git -C "$parent" rev-parse --path-format=absolute --git-dir)
common_dir=$(git -C "$parent" rev-parse --path-format=absolute --git-common-dir)
if [ "$own_dir" = "$common_dir" ]; then
    printf '%s is the primary checkout, which owns no sub-worktrees.\nCreate a top-level worktree instead: wt switch --create %q\n' "$parent" "$branch" >&2
    exit 65
fi

args=(switch --create --no-cd)
if [ -n "$base" ]; then args+=(--base "$base"); fi
# Hooks and approvals run as usual: no --yes, no --no-hooks.
"$wt" -C "$parent" "${args[@]}" "$branch"

"$wt" -C "$parent" config state vars set --branch="$branch" "overseer-parent=$parent_branch" >/dev/null || {
    printf 'Created %s but could not record its parent. Run:\n  wt config state vars set --branch=%q overseer-parent=%q\n' \
        "$branch" "$branch" "$parent_branch" >&2
    exit 1
}

path=$(git -C "$parent" worktree list --porcelain | awk -v ref="refs/heads/$branch" '
    $1 == "worktree" { path = substr($0, 10) }
    $1 == "branch" && $2 == ref { print path }
')
if [ -n "$brief" ]; then
    git_dir=$(git -C "$path" rev-parse --absolute-git-dir)
    printf '%s\n' "$brief" > "$git_dir/overseer-brief.md"
    printf 'Overseer will start an omp session there with your brief.\n'
fi
printf 'Created %s under %s\n%s\n' "$branch" "$parent_branch" "$path"
